{
  "name": "Dx29-server",
  "version": "1.0.0",
  "description": "Dx29 server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "serve": "nodemon index.js",
    "dev": "nodemon --ignore '*.log' --ignore 'logs/*' --ignore 'node_modules/*' index.js",
    "test": "node --test test/intentClassifier.test.js test/multimodalInput.test.js test/multimodalAssetService.test.js test/multimodalImageResolver.test.js test/blobFiles.test.js test/documentIntelligenceService.test.js",
    "validate-openapi": "swagger-cli validate docs/dxgpt-api.yaml",
    "generate-openapi": "node scripts/generate-openapi.js",
    "swagger-ui": "node scripts/serve-swagger-ui.js",
    "cost:daily-durations": "node scripts/daily-operation-durations.js"
  },
  "author": "LOA",
  "license": "MIT",
  "dependencies": {
    "@azure-rest/ai-document-intelligence": "^1.0.0",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.16.0",
    "@azure/web-pubsub": "^1.2.0",
    "applicationinsights": "^2.9.6",
    "async": "^2.6.4",
    "axios": "^1.19.0",
    "body-parser": "^1.20.6",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "express-handlebars": "^7.1.3",
    "express-rate-limit": "^7.5.0",
    "js-tiktoken": "^1.0.20",
    "jsonrepair": "^3.13.1",
    "mongoose": "^8.24.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "nodemailer-express-handlebars": "^6.1.2",
    "openai": "^4.104.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "swagger-cli": "^4.0.4",
    "swagger-jsdoc": "^6.2.8",
    "yaml": "^2.8.0"
  },
  "volta": {
    "node": "18.20.6"
  },
  "nodemonConfig": {
    "ignore": [
      "*.log",
      "logs/*",
      "node_modules/*",
      ".git/*",
      ".env"
    ],
    "delay": "2500"
  }
}
