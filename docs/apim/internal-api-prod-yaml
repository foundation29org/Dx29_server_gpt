        "/speech/transcribe": {
            "post": {
                "tags": [
                    "Speech"
                ],
                "summary": "Transcribe dictated audio to text",
                "description": "Tenant-only. Transcribes one microphone recording to text. The spoken language is detected automatically. Pass `language` (ISO 639-1) as a hint. Audio is kept in memory for the request and is not stored.\n\n**File limits:** exactly one file, form field `audio`, maximum 10 MB. Formats: WebM, Ogg, MP4, M4A, MP3, WAV.\n\nAn empty `text` means no speech was detected.",
                "operationId": "post-speech-transcribe",
                "parameters": [
                    {
                        "name": "X-Tenant-Id",
                        "in": "header",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "multipart/form-data": {
                            "schema": {
                                "required": [
                                    "audio"
                                ],
                                "type": "object",
                                "properties": {
                                    "audio": {
                                        "type": "string",
                                        "format": "binary",
                                        "description": "Audio recording. WebM, Ogg, MP4, M4A, MP3 or WAV, up to 10 MB."
                                    },
                                    "language": {
                                        "pattern": "^[a-z]{2}$",
                                        "type": "string",
                                        "description": "Optional ISO 639-1 hint, for example `es` or `en`.",
                                        "example": "es"
                                    },
                                    "myuuid": {
                                        "type": "string"
                                    },
                                    "timezone": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Transcript. `text` is empty when no speech was detected.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "text": {
                                            "type": "string"
                                        }
                                    },
                                    "example": {
                                        "text": "Hola, a ver si funciona la transcripción."
                                    }
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Missing or invalid audio"
                    },
                    "401": {
                        "description": "Invalid or missing subscription key",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Invalid or missing subscription key"
                                        }
                                    }
                                },
                                "example": {
                                    "error": "Invalid or missing subscription key"
                                }
                            }
                        }
                    },
                    "403": {
                        "description": "Missing X-Tenant-Id"
                    },
                    "413": {
                        "description": "Audio larger than 10 MB"
                    },
                    "415": {
                        "description": "Unsupported audio format"
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "error": {
                                            "type": "string",
                                            "example": "Too many requests, please try again later"
                                        }
                                    }
                                },
                                "example": {
                                    "error": "Too many requests, please try again later"
                                }
                            }
                        }
                    },
                    "502": {
                        "description": "Transcription failed"
                    },
                    "503": {
                        "description": "Transcription service not configured"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Language": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "en"
                    },
                    "name": {
                        "type": "string",
                        "example": "English"
                    }
                }
            },
            "SupportRequest": {
                "required": [
                    "email",
                    "message"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "OpinionRequest": {
                "required": [
                    "value",
                    "myuuid",
                    "vote",
                    "versionModel"
                ],
                "type": "object",
                "properties": {
                    "value": {
                        "maxLength": 10000,
                        "type": "string"
                    },
                    "myuuid": {
                        "pattern": "^[0-9a-fA-F-]{36}$",
                        "type": "string"
                    },
                    "vote": {
                        "enum": [
                            "up",
                            "down"
                        ],
                        "type": "string"
                    },
                    "lang": {
                        "maxLength": 2,
                        "minLength": 2,
                        "type": "string"
                    },
                    "topRelatedConditions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "maxLength": 200,
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "versionModel": {
                        "type": "string",
                        "description": "Model version for the feedback"
                    }
                }
            },
            "OpinionResponse": {
                "type": "object",
                "properties": {
                    "send": {
                        "type": "boolean",
                        "example": true
                    }
                }
            },
            "GeneralFeedbackRequest": {
                "required": [
                    "value",
                    "myuuid"
                ],
                "type": "object",
                "properties": {
                    "value": {
                        "required": [
                            "pregunta1",
                            "pregunta2",
                            "userType",
                            "moreFunct"
                        ],
                        "type": "object",
                        "properties": {
                            "pregunta1": {
                                "maximum": 5,
                                "minimum": 0,
                                "type": "number"
                            },
                            "pregunta2": {
                                "maximum": 5,
                                "minimum": 0,
                                "type": "number"
                            },
                            "userType": {
                                "maxLength": 100,
                                "type": "string"
                            },
                            "moreFunct": {
                                "maxLength": 1000,
                                "type": "string"
                            },
                            "freeText": {
                                "maxLength": 2000,
                                "type": "string"
                            },
                            "email": {
                                "type": "string",
                                "format": "email"
                            }
                        }
                    },
                    "myuuid": {
                        "pattern": "^[0-9a-fA-F-]{36}$",
                        "type": "string"
                    },
                    "lang": {
                        "maxLength": 2,
                        "minLength": 2,
                        "type": "string"
                    }
                }
            },
            "GeneralFeedbackResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    }
                }
            },
            "SystemStatusResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "enum": [
