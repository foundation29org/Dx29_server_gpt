    "components": {
        "schemas": {
            "Language": {
                "type": "object",
                "properties": {
                    "code": {
                        "type": "string",
                        "example": "en"
                    },
                    "name": {
                        "type": "string",
                        "example": "English"
                    }
                }
            },
            "SupportRequest": {
                "required": ["email", "message"],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "message": {
                        "type": "string"
                    }
                }
            },
            "OpinionRequest": {
                "required": ["value", "myuuid", "vote", "isNewModel"],
                "type": "object",
                "properties": {
                    "value": {
                        "maxLength": 10000,
                        "type": "string"
                    },
                    "myuuid": {
                        "pattern": "^[0-9a-fA-F-]{36}$",
                        "type": "string"
                    },
                    "vote": {
                        "enum": ["up", "down"],
                        "type": "string"
                    },
                    "lang": {
                        "maxLength": 2,
                        "minLength": 2,
                        "type": "string"
                    },
                    "isNewModel": {
                        "type": "boolean"
                    },
                    "topRelatedConditions": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "maxLength": 200,
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            },
            "OpinionResponse": {
                "type": "object",
                "properties": {
                    "send": {
                        "type": "boolean",
                        "example": true
                    }
                }
            },
            "GeneralFeedbackRequest": {
                "required": ["value", "myuuid"],
                "type": "object",
                "properties": {
                    "value": {
                        "required": ["pregunta1", "pregunta2", "userType", "moreFunct"],
                        "type": "object",
                        "properties": {
                            "pregunta1": {
                                "maximum": 5,
                                "minimum": 0,
                                "type": "number"
                            },
                            "pregunta2": {
                                "maximum": 5,
                                "minimum": 0,
                                "type": "number"
                            },
                            "userType": {
                                "maxLength": 100,
                                "type": "string"
                            },
                            "moreFunct": {
                                "maxLength": 1000,
                                "type": "string"
                            },
                            "freeText": {
                                "maxLength": 2000,
                                "type": "string"
                            },
                            "email": {
                                "type": "string",
                                "format": "email"
                            }
                        }
                    },
                    "myuuid": {
                        "pattern": "^[0-9a-fA-F-]{36}$",
                        "type": "string"
                    },
                    "lang": {
                        "maxLength": 2,
                        "minLength": 2,
                        "type": "string"
                    }
                }
            },
            "GeneralFeedbackResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string",
                        "example": "success"
                    }
                }
            },
            "SystemStatusResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "enum": ["online", "degraded", "offline"],
                        "type": "string"
                    },
                    "services": {
                        "type": "object",
                        "additionalProperties": {
                            "enum": ["online", "degraded", "offline"],
                            "type": "string"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "apiKeyHeader": {
                "type": "apiKey",
                "name": "Ocp-Apim-Subscription-Key",
                "in": "header"
            },
            "apiKeyQuery": {
                "type": "apiKey",
                "name": "subscription-key",
                "in": "query"
            }
        }
    },
    "security": [{
        "apiKeyHeader": []
    }, {
        "apiKeyQuery": []
    }]
}